<div class="mx-auto max-w-3xl space-y-6">
  <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-8 shadow-2xl shadow-slate-950/30">
    <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Productos</p>
    <h1 class="mt-3 text-4xl font-semibold text-white">Editar producto</h1>
    <p class="mt-2 text-slate-400">Actualiza los datos del producto existente.</p>
  </div>

  <%= render "form", product: @product %>

  <div class="flex justify-end">
    <%= link_to "Volver a productos", products_path, class: "rounded-full border border-slate-700 bg-slate-900/80 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300" %>
  </div>
</div>
