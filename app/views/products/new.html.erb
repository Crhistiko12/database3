<div class="mx-auto max-w-3xl rounded-3xl border border-slate-800/90 bg-slate-900/85 p-8 shadow-2xl shadow-slate-950/30">
  <div class="mb-8">
    <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Productos</p>
    <h1 class="mt-3 text-4xl font-semibold text-white">Nuevo Producto</h1>
    <p class="mt-2 text-slate-400">Agrega un nuevo producto al inventario de tu tienda.</p>
  </div>

  <%= form_with(model: @product, local: true, class: "space-y-6") do |form| %>
    <% if @product.errors.any? %>
      <div class="rounded-3xl border border-rose-500/20 bg-rose-500/5 p-4 text-sm text-rose-100">
        <p class="font-semibold">⚠️ <%= pluralize(@product.errors.count, "error") %> encontrado(s):</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-rose-100/80">
          <% @product.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nombre del producto", class: "block text-sm font-semibold text-slate-200" %>
      <%= form.text_field :name, class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 text-base text-slate-100 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", required: true %>
    </div>

    <div>
      <%= form.label :description, "Descripción", class: "block text-sm font-semibold text-slate-200" %>
      <%= form.text_area :description, class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 text-base text-slate-100 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", rows: 5 %>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <div>
        <%= form.label :price, "Precio ($)", class: "block text-sm font-semibold text-slate-200" %>
        <%= form.number_field :price, step: 0.01, class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 text-base text-slate-100 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", required: true %>
      </div>

      <div>
        <%= form.label :stock, "Stock", class: "block text-sm font-semibold text-slate-200" %>
        <%= form.number_field :stock, class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 text-base text-slate-100 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", required: true %>
      </div>
    </div>

    <div>
      <%= form.label :image, "Imagen del producto", class: "block text-sm font-semibold text-slate-200" %>
      <%= form.file_field :image, class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-3 text-base text-slate-100 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", accept: "image/*" %>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <%= form.submit "✅ Guardar Producto", class: "inline-flex w-full items-center justify-center rounded-full bg-cyan-500 px-6 py-4 text-base font-semibold text-slate-950 transition hover:bg-cyan-400 sm:w-auto" %>
      <%= link_to "❌ Cancelar", products_path, class: "inline-flex w-full items-center justify-center rounded-full border border-slate-700 bg-slate-900/70 px-6 py-4 text-base font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300 sm:w-auto" %>
    </div>
  <% end %>
</div>
