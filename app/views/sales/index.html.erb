<div data-controller="sale-modal" class="mx-auto space-y-8">
  <div class="rounded-3xl border border-slate-800/90 bg-slate-900/80 p-8 shadow-2xl shadow-slate-950/20 backdrop-blur-xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Historial</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white">Ventas Realizadas</h1>
        <p class="mt-2 max-w-2xl text-slate-400">Revisa todas las ventas completadas con detalles y comprobantes.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "← Volver a Productos", products_path, class: "inline-flex items-center rounded-full bg-slate-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-950/20 transition hover:bg-slate-600" %>
      </div>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-800/90 bg-slate-900/80 p-8 shadow-2xl shadow-slate-950/20 backdrop-blur-xl">
    <% if @sales.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-slate-300">
          <thead class="text-xs uppercase tracking-wider text-slate-400">
            <tr>
              <th class="px-6 py-3 text-left">Fecha</th>
              <th class="px-6 py-3 text-left">Producto</th>
              <th class="px-6 py-3 text-left">Cantidad</th>
              <th class="px-6 py-3 text-left">Total</th>
              <th class="px-6 py-3 text-left">Comprador</th>
              <th class="px-6 py-3 text-left">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-700">
            <% @sales.each do |sale| %>
              <tr class="hover:bg-slate-800/50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= l sale.created_at, format: :short %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= sale.product.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= sale.quantity %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  $<%= number_with_precision(sale.product.price * sale.quantity, precision: 2) %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= sale.buyer_name %><br>
                  <span class="text-xs text-slate-500"><%= sale.buyer_email %></span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= link_to "Ver PDF", sale_path(sale, format: :pdf), target: "_blank", class: "inline-flex items-center rounded-full bg-emerald-500 px-4 py-2 text-xs font-semibold text-white shadow-lg shadow-emerald-500/20 transition hover:bg-emerald-400" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-slate-400">No hay ventas registradas aún.</p>
      </div>
    <% end %>
  </div>
</div>