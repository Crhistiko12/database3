<div class="mx-auto space-y-8">
  <div class="rounded-3xl border border-slate-800/90 bg-slate-900/80 p-8 shadow-2xl shadow-slate-950/20 backdrop-blur-xl">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Perfil</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-white">Mi perfil</h1>
        <p class="mt-2 max-w-2xl text-slate-400">Resumen de tus productos y ventas.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <%= link_to "Productos", products_path, class: "inline-flex items-center rounded-full border border-slate-700 bg-slate-950/80 px-5 py-3 text-sm font-semibold text-white transition hover:border-cyan-400 hover:text-cyan-300" %>
      </div>
    </div>
  </div>

  <div class="grid gap-6 lg:grid-cols-4">
    <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-6 shadow-lg shadow-slate-950/20">
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Cuenta</p>
      <p class="mt-3 text-3xl font-semibold text-white"><%= current_user.email_address %></p>
    </div>

    <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-6 shadow-lg shadow-slate-950/20">
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Productos</p>
      <p class="mt-3 text-3xl font-semibold text-white"><%= @product_count %></p>
      <p class="mt-2 text-sm text-slate-400">Productos creados</p>
    </div>

    <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-6 shadow-lg shadow-slate-950/20">
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Ventas</p>
      <p class="mt-3 text-3xl font-semibold text-white"><%= @sales_count %></p>
      <p class="mt-2 text-sm text-slate-400">Ventas totales</p>
    </div>

    <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-6 shadow-lg shadow-slate-950/20">
      <p class="text-sm uppercase tracking-[0.35em] text-slate-500">Stock</p>
      <p class="mt-3 text-3xl font-semibold text-white"><%= @stock_total %></p>
      <p class="mt-2 text-sm text-slate-400">Unidades disponibles</p>
    </div>
  </div>

  <div class="rounded-3xl border border-slate-800/90 bg-slate-900/85 p-8 shadow-lg shadow-slate-950/20">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-300">Resumen financiero</p>
        <h2 class="mt-2 text-3xl font-semibold text-white">Ingresos estimados</h2>
      </div>
      <p class="text-3xl font-semibold text-white">$<%= number_with_precision(@revenue, precision: 2) %></p>
    </div>
    <p class="mt-4 text-sm text-slate-400">Esta cifra corresponde al total facturado por las ventas de tus productos.</p>
  </div>
</div>
