<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Proyect Catec" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Proyect Catec">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-950 text-slate-100">
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/95 backdrop-blur-xl">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <%= link_to "ProyectCatec", root_path, class: "text-xl font-semibold tracking-tight text-white" %>

        <div class="flex items-center gap-3 text-sm font-medium">
          <% if authenticated? %>
            <%= link_to "Productos", products_path, class: "rounded-full border border-slate-700 bg-slate-900/80 px-4 py-2 text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300" %>
            <%= button_to "Cerrar sesión", session_path, method: :delete, class: "rounded-full bg-cyan-500 px-4 py-2 text-slate-950 transition hover:bg-cyan-400" %>
          <% else %>
            <%= link_to "Iniciar sesión", new_session_path, class: "rounded-full border border-slate-700 bg-slate-900/80 px-4 py-2 text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300" %>
            <%= link_to "Registrarse", new_registration_path, class: "rounded-full bg-cyan-500 px-4 py-2 text-slate-950 transition hover:bg-cyan-400" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <% if flash.any? %>
        <div class="mb-6 space-y-3">
          <% flash.each do |type, message| %>
            <div class="rounded-3xl border border-slate-700 bg-slate-900/85 px-5 py-4 text-sm font-medium text-slate-100 shadow-lg shadow-slate-950/20">
              <span class="font-semibold"><%= type.to_s.humanize %>:</span> <%= message %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
