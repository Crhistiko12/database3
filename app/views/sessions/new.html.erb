<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg rounded-[32px] border border-white/10 bg-slate-900/90 p-10 shadow-2xl shadow-slate-950/40 backdrop-blur-xl">
    <div class="mb-10 text-center">
      <span class="inline-flex rounded-full bg-cyan-500/10 px-4 py-1 text-sm font-semibold uppercase tracking-[0.35em] text-cyan-300">Panel administrativo</span>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white">Inicia sesión</h1>
      <p class="mt-4 text-sm leading-6 text-slate-400">Accede a tu dashboard y visualiza los productos ya creados en tu tienda.</p>
    </div>

    <%= form_with url: session_path, scope: :session, class: "space-y-6", data: { controller: "show-password" } do |f| %>
      <div>
        <label for="session_email_address" class="block text-sm font-semibold text-slate-200">Email</label>
        <%= f.email_field :email_address, required: true, id: "session_email_address", class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/70 px-4 py-4 text-base text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20" %>
      </div>

      <div>
        <label for="session_password" class="block text-sm font-semibold text-slate-200">Contraseña</label>
        <div class="mt-3 relative">
          <%= f.password_field :password, required: true, id: "session_password", class: "w-full rounded-3xl border border-slate-700 bg-slate-950/70 px-4 py-4 pr-12 text-base text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20", data: { show_password_target: "password" } %>
          <button type="button" data-action="show-password#toggle" data-show-password-target="icon" class="absolute inset-y-0 right-3 flex items-center text-slate-400 transition hover:text-white" aria-label="Mostrar contraseña">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
      </div>

      <%= f.submit "Ingresar", class: "w-full rounded-full bg-cyan-500 px-6 py-4 text-base font-semibold text-slate-950 shadow-lg shadow-cyan-500/20 transition hover:bg-cyan-400" %>
    <% end %>

    <div class="mt-6 flex flex-col gap-2 text-center text-sm text-slate-400">
      <%= link_to "¿Olvidaste tu contraseña?", new_password_reset_path, class: "font-semibold text-white hover:text-cyan-300" %>
      <p>¿No tienes cuenta? <%= link_to "Regístrate aquí", new_registration_path, class: "font-semibold text-white hover:text-cyan-300" %></p>
    </div>
  </div>
</div>
