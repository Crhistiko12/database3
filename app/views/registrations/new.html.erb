<div class="min-h-screen flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-lg rounded-[32px] border border-white/10 bg-slate-900/95 p-10 shadow-2xl shadow-slate-950/40 backdrop-blur-xl">
    <div class="mb-10 text-center">
      <span class="inline-flex rounded-full bg-cyan-500/10 px-4 py-1 text-sm font-semibold uppercase tracking-[0.35em] text-cyan-300">Registro</span>
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-white">Crea tu cuenta</h1>
      <p class="mt-4 text-sm leading-6 text-slate-400">Regístrate para comenzar a administrar tus productos en el dashboard.</p>
    </div>

    <% if @user.errors.any? %>
      <div class="mb-6 rounded-lg border border-red-500/50 bg-red-500/10 p-4">
        <p class="mb-2 text-sm font-semibold text-red-400">
          <%= @user.errors.count == 1 ? "Error" : "#{@user.errors.count} errores" %> en el formulario:
        </p>
        <ul class="list-inside space-y-1">
          <% @user.errors.full_messages.each do |msg| %>
            <li class="text-sm text-red-300">• <%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @user, url: registration_path, class: "space-y-6", data: { controller: "show-password" } do |f| %>
      <div>
        <label for="user_email_address" class="block text-sm font-semibold text-slate-200">Email</label>
        <%= f.email_field :email_address, required: true, id: "user_email_address", class: "mt-3 w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 text-base text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20" %>
      </div>

      <div>
        <label for="user_password" class="block text-sm font-semibold text-slate-200">Contraseña</label>
        <div class="mt-3 relative password-field-wrapper">
          <%= f.password_field :password, required: true, id: "user_password", class: "w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 pr-12 text-base text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20" %>
          <button type="button" data-action="show-password#toggle" class="absolute inset-y-0 right-3 flex items-center text-slate-400 transition hover:text-white" aria-label="Mostrar contraseña">
            <span data-show-password-target="icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
          </button>
        </div>
      </div>

      <div>
        <label for="user_password_confirmation" class="block text-sm font-semibold text-slate-200">Confirmar contraseña</label>
        <div class="mt-3 relative password-field-wrapper">
          <%= f.password_field :password_confirmation, required: true, id: "user_password_confirmation", class: "w-full rounded-3xl border border-slate-700 bg-slate-950/80 px-4 py-4 pr-12 text-base text-slate-100 placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20" %>
          <button type="button" data-action="show-password#toggle" class="absolute inset-y-0 right-3 flex items-center text-slate-400 transition hover:text-white" aria-label="Mostrar contraseña">
            <span data-show-password-target="icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </span>
          </button>
        </div>
      </div>

      <%= f.submit "Registrarse", class: "w-full rounded-full bg-cyan-500 px-6 py-4 text-base font-semibold text-slate-950 transition hover:bg-cyan-400" %>
    <% end %>

    <p class="mt-8 text-center text-sm text-slate-400">¿Ya tienes cuenta? <%= link_to "Inicia sesión", new_session_path, class: "font-semibold text-white hover:text-cyan-300" %></p>
  </div>
</div>
